<item ident="QUE_1" title="Rules-Based Programming vs. Machine Learning">
<itemmetadata>
<qtimetadata>
<qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>matching_question</fieldentry></qtimetadatafield>
<qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>2</fieldentry></qtimetadatafield>
<qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>1,2</fieldentry></qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/plain">Match each scenario to whether it describes Rules-Based Programming or Machine Learning.</mattext>
</material>

<response_lid ident="response_1" match_group="response_1,response_2,response_3,response_4,response_5,response_6,response_7,response_8">
<material><mattext texttype="text/plain">A fraud analyst writes a rule that flags any transaction over $5,000.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Rules-Based Programming</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Machine Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_2" match_group="response_1,response_2,response_3,response_4,response_5,response_6,response_7,response_8">
<material><mattext texttype="text/plain">A model is trained on 10,000 past transactions labeled fraud or not fraud.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Rules-Based Programming</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Machine Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_3" match_group="response_1,response_2,response_3,response_4,response_5,response_6,response_7,response_8">
<material><mattext texttype="text/plain">The programmer specifies the exact decision logic in advance.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Rules-Based Programming</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Machine Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_4" match_group="response_1,response_2,response_3,response_4,response_5,response_6,response_7,response_8">
<material><mattext texttype="text/plain">An algorithm learns which combination of transaction amount, location, and time predicts fraud.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Rules-Based Programming</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Machine Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_5" match_group="response_1,response_2,response_3,response_4,response_5,response_6,response_7,response_8">
<material><mattext texttype="text/plain">A new loan officer is told: if annual income is below $20,000, deny the loan.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Rules-Based Programming</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Machine Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_6" match_group="response_1,response_2,response_3,response_4,response_5,response_6,response_7,response_8">
<material><mattext texttype="text/plain">A bank estimates default risk by learning from the outcomes of thousands of past loans.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Rules-Based Programming</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Machine Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_7" match_group="response_1,response_2,response_3,response_4,response_5,response_6,response_7,response_8">
<material><mattext texttype="text/plain">The same output always follows from the same input, based on a fixed rule someone wrote.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Rules-Based Programming</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Machine Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_8" match_group="response_1,response_2,response_3,response_4,response_5,response_6,response_7,response_8">
<material><mattext texttype="text/plain">The model's predictions depend on patterns learned from historical, labeled examples.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Rules-Based Programming</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Machine Learning</mattext></material></response_label>
</render_choice>
</response_lid>

</presentation>
<resprocessing>
<outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes>
<respcondition continue="Yes"><conditionvar><varequal respident="response_1">1</varequal></conditionvar><setvar action="Add" varname="SCORE">12.5</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_2">2</varequal></conditionvar><setvar action="Add" varname="SCORE">12.5</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_3">1</varequal></conditionvar><setvar action="Add" varname="SCORE">12.5</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_4">2</varequal></conditionvar><setvar action="Add" varname="SCORE">12.5</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_5">1</varequal></conditionvar><setvar action="Add" varname="SCORE">12.5</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_6">2</varequal></conditionvar><setvar action="Add" varname="SCORE">12.5</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_7">1</varequal></conditionvar><setvar action="Add" varname="SCORE">12.5</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_8">2</varequal></conditionvar><setvar action="Add" varname="SCORE">12.5</setvar></respcondition>
</resprocessing>
<itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/plain">Correct! You're telling apart hand-written rules from patterns learned from data.</mattext></material></flow_mat></itemfeedback>
<itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/plain">Not quite - review the Rules-Based Programming vs. Machine Learning slide and try again.</mattext></material></flow_mat></itemfeedback>
</item>

<item ident="QUE_2" title="Supervised vs. Unsupervised Learning">
<itemmetadata>
<qtimetadata>
<qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>matching_question</fieldentry></qtimetadatafield>
<qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>2</fieldentry></qtimetadatafield>
<qtimetadatafield><fieldlabel>original_answer_ids</fieldlabel><fieldentry>1,2</fieldentry></qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/plain">Match each scenario to Supervised Learning or Unsupervised Learning.</mattext>
</material>

<response_lid ident="response_1" match_group="response_1,response_2,response_3,response_4,response_5,response_6">
<material><mattext texttype="text/plain">Predicting loan default using past loans with known outcomes.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Supervised Learning</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Unsupervised Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_2" match_group="response_1,response_2,response_3,response_4,response_5,response_6">
<material><mattext texttype="text/plain">Grouping customers into segments based on purchase behavior, with no predefined labels.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Supervised Learning</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Unsupervised Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_3" match_group="response_1,response_2,response_3,response_4,response_5,response_6">
<material><mattext texttype="text/plain">Predicting customer churn using historical records of who canceled and who did not.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Supervised Learning</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Unsupervised Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_4" match_group="response_1,response_2,response_3,response_4,response_5,response_6">
<material><mattext texttype="text/plain">Finding natural groupings among products based on purchase patterns.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Supervised Learning</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Unsupervised Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_5" match_group="response_1,response_2,response_3,response_4,response_5,response_6">
<material><mattext texttype="text/plain">Estimating next quarter's revenue using past revenue and marketing spend.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Supervised Learning</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Unsupervised Learning</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="response_6" match_group="response_1,response_2,response_3,response_4,response_5,response_6">
<material><mattext texttype="text/plain">Discovering that shoppers fall into a frequent-small-purchase group and an infrequent-large-purchase group, without being told these groups exist beforehand.</mattext></material>
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Supervised Learning</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Unsupervised Learning</mattext></material></response_label>
</render_choice>
</response_lid>

</presentation>
<resprocessing>
<outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes>
<respcondition continue="Yes"><conditionvar><varequal respident="response_1">1</varequal></conditionvar><setvar action="Add" varname="SCORE">16.67</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_2">2</varequal></conditionvar><setvar action="Add" varname="SCORE">16.67</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_3">1</varequal></conditionvar><setvar action="Add" varname="SCORE">16.67</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_4">2</varequal></conditionvar><setvar action="Add" varname="SCORE">16.67</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_5">1</varequal></conditionvar><setvar action="Add" varname="SCORE">16.67</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="response_6">2</varequal></conditionvar><setvar action="Add" varname="SCORE">16.65</setvar></respcondition>
</resprocessing>
<itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/plain">Correct! You're telling apart labeled data (supervised) from unlabeled data (unsupervised).</mattext></material></flow_mat></itemfeedback>
<itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/plain">Not quite - review the Supervised vs. Unsupervised slide and try again.</mattext></material></flow_mat></itemfeedback>
</item>

<item ident="QUE_3" title="Business Problem to ML Task">
<itemmetadata>
<qtimetadata>
<qtimetadatafield><fieldlabel>question_type</fieldlabel><fieldentry>multiple_dropdowns_question</fieldentry></qtimetadatafield>
<qtimetadatafield><fieldlabel>points_possible</fieldlabel><fieldentry>5</fieldentry></qtimetadatafield>
</qtimetadata>
</itemmetadata>
<presentation>
<material>
<mattext texttype="text/html">&lt;p&gt;A regional grocery chain is experiencing frequent stockouts of popular items, which frustrates customers and reduces sales.&lt;/p&gt;&lt;p&gt;Business Problem: [business_problem]&lt;/p&gt;&lt;p&gt;Decision: [decision]&lt;/p&gt;&lt;p&gt;ML Task: [ml_task]&lt;/p&gt;&lt;p&gt;Unit of Analysis: [unit]&lt;/p&gt;&lt;p&gt;Success: [success]&lt;/p&gt;</mattext>
</material>

<response_lid ident="business_problem">
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Frequent stockouts of popular items are frustrating customers and reducing sales.</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">The store needs a new inventory management system.</mattext></material></response_label>
<response_label ident="3"><material><mattext texttype="text/plain">Customers are unhappy with the store layout.</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="decision">
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">How much of each product to order and when to restock it.</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Which employees to schedule for each shift.</mattext></material></response_label>
<response_label ident="3"><material><mattext texttype="text/plain">Which items to feature on the end-cap display.</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="ml_task">
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">Predict future demand for each product at each store.</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">Automatically reorder inventory with no human review.</mattext></material></response_label>
<response_label ident="3"><material><mattext texttype="text/plain">Rank employees by performance.</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="unit">
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">A product at a specific store, for a given time period (e.g., product-week).</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">An individual customer.</mattext></material></response_label>
<response_label ident="3"><material><mattext texttype="text/plain">A single transaction receipt.</mattext></material></response_label>
</render_choice>
</response_lid>

<response_lid ident="success">
<render_choice>
<response_label ident="1"><material><mattext texttype="text/plain">A meaningful reduction in the stockout rate without a large increase in excess inventory.</mattext></material></response_label>
<response_label ident="2"><material><mattext texttype="text/plain">The model achieves 100% prediction accuracy.</mattext></material></response_label>
<response_label ident="3"><material><mattext texttype="text/plain">The store manager stops reviewing inventory reports.</mattext></material></response_label>
</render_choice>
</response_lid>

</presentation>
<resprocessing>
<outcomes><decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/></outcomes>
<respcondition continue="Yes"><conditionvar><varequal respident="business_problem">1</varequal></conditionvar><setvar action="Add" varname="SCORE">20</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="decision">1</varequal></conditionvar><setvar action="Add" varname="SCORE">20</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="ml_task">1</varequal></conditionvar><setvar action="Add" varname="SCORE">20</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="unit">1</varequal></conditionvar><setvar action="Add" varname="SCORE">20</setvar></respcondition>
<respcondition continue="Yes"><conditionvar><varequal respident="success">1</varequal></conditionvar><setvar action="Add" varname="SCORE">20</setvar></respcondition>
</resprocessing>
<itemfeedback ident="correct_fb"><flow_mat><material><mattext texttype="text/plain">Correct! You matched the business problem to the right decision, task, and success measure.</mattext></material></flow_mat></itemfeedback>
<itemfeedback ident="general_incorrect_fb"><flow_mat><material><mattext texttype="text/plain">Not quite - review the "Start With the Business Problem" framework and try again.</mattext></material></flow_mat></itemfeedback>
</item>

